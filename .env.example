# SERVER ONLY. Set in Vercel > Project > Settings > Environment Variables.
SUPABASE_URL=
# Supabase secret key OR legacy service_role key. Never use an anon/publishable key.
SUPABASE_SECRET_KEY=
# Four-digit prototype PIN, entered in Vercel, not committed to GitHub.
APP_PIN=
# Optional: use this instead of APP_PIN for an existing PBKDF2 JSON hash.
PROTOTYPE_PIN_HASH=
